        {
          "k": "text",
          "text": "01",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Briefing"
        },
        {
          "k": "text",
          "text": "A call or a chat about your business, your customers and what the project has to achieve. You get a written scope with a fixed price and timeline."
        },
        {
          "k": "text",
          "text": "· 1–2 days",
          "role": "proc-term"
        },
        {
          "k": "text",
          "text": "02",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Prototype"
        },
        {
          "k": "text",
          "text": "We show the structure and user flow before any code is written. Changes at this stage are quick and cost nothing extra."
        },
        {
          "k": "text",
          "text": "· 3–5 days",
          "role": "proc-term"
        },
        {
          "k": "text",
          "text": "03",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Development"
        },
        {
          "k": "text",
          "text": "Design, code and integrations. You get a staging link and regular progress updates, so there are no surprises at the end."
        },
        {
          "k": "text",
          "text": "· depends on scope",
          "role": "proc-term"
        },
        {
          "k": "text",
          "text": "04",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Testing"
        },
        {
          "k": "text",
          "text": "We test real scenarios on phones and desktops: forms, payments, bot flows and edge cases. Bugs get fixed before launch."
        },
        {
          "k": "text",
          "text": "· 2–4 days",
          "role": "proc-term"
        },
        {
          "k": "text",
          "text": "05",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Launch"
        },
        {
          "k": "text",
          "text": "We deploy, connect analytics and hand over the source code and all access. The product is registered to you, not to us."
        },
        {
          "k": "text",
          "text": "· 1 day",
          "role": "proc-term"
        },
        {
          "k": "text",
          "text": "06",
          "role": "proc-n"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Support"
        },
        {
          "k": "text",
          "text": "One month of support is included with every website. After that, support plans start at $150/month, or we work by the hour."
        },
        {
          "k": "text",
          "text": "· ongoing",
          "role": "proc-term"
        }
      ]
