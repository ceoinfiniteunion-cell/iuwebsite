        {
          "k": "h",
          "level": 3,
          "text": "Dashboards and reporting"
        },
        {
          "k": "text",
          "text": "Data from your ad accounts, CRM or database collected in one screen and refreshed automatically. Our own Ad Tracker, which pulls Meta, Google and TikTok Ads into one dashboard, is built this way.",
          "role": "what-desc"
        },
        {
          "k": "text",
          "text": "Analytics · API · Auto-refresh",
          "role": "what-tags"
        },
        {
          "k": "text",
          "text": "04",
          "role": "what-num"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Internal tools"
        },
        {
          "k": "text",
          "text": "Order management, task tracking, payroll or stock: software built around how your team actually works, connected to Telegram for notifications.",
          "role": "what-desc"
        },
        {
          "k": "text",
          "text": "Workflows · Telegram · Integrations",
          "role": "what-tags"
        }
      ]
    },
