        },
        {
          "k": "h",
          "level": 2,
          "text": "When spreadsheets and plugins stop working"
        },
        {
          "k": "text",
          "text": "01",
          "role": "what-num"
        },
        {
          "k": "h",
          "level": 3,
          "text": "The idea needs real users"
        },
        {
          "k": "text",
          "text": "You have a product idea and want paying customers before investing a year of development. You need a focused MVP that does one job well, not a prototype that falls apart once real users arrive.",
          "role": "what-desc"
        },
        {
          "k": "text",
          "text": "02",
          "role": "what-num"
        },
        {
          "k": "h",
          "level": 3,
          "text": "The business outgrew its tools"
        },
        {
          "k": "text",
          "text": "Orders live in one spreadsheet, clients in another, reports are put together by hand every Friday. Off-the-shelf software covers most of the process, and the part it misses is where the time goes.",
          "role": "what-desc"
        }
      ]
    },
    {
