        {
          "k": "text",
          "text": "Users, core scenarios and what goes into version one. You get a written scope and a fixed quote.",
          "role": "stack-sub"
        },
        {
          "k": "text",
          "text": "STAGE 02 · 3–5 DAYS",
          "role": "stack-cat"
        },
        {
          "k": "h",
          "level": 3,
          "text": "Prototype"
        },
        {
          "k": "text",
          "text": "Clickable screens for the main flows, so you can test the logic before code is written.",
