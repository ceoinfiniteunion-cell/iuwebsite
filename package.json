{
  "name": "iu-site",
  "version": "1.0.0",
  "description": "Infinite Union website",
  "scripts": {
    "lint:html": "html-validate index.html \"en/**/index.html\" \"services/*/index.html\" \"blog/**/index.html\" \"portfolio/index.html\" \"pricing/index.html\" 404.html",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:js": "eslint index.html \"services/*/index.html\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lhci": "lhci autorun",
    "start": "npx serve . -p $PORT -c serve.json",
    "minify:css": "csso src/css/main.css --output assets/css/main.css",
    "minify:js": "terser src/js/ui.js -o assets/js/ui.js --compress --mangle && terser src/js/globe.js -o assets/js/globe.js --compress --mangle && terser src/js/snake.js -o assets/js/snake.js --compress --mangle && terser src/js/orbit.js -o assets/js/orbit.js --compress --mangle && terser src/js/hero.js -o assets/js/hero.js --compress --mangle && terser src/js/preloader.js -o assets/js/preloader.js --compress --mangle && terser src/js/main.js -o assets/js/main.js --compress --mangle",
    "minify:html": "html-minifier-terser --input-dir . --output-dir . --file-ext html --collapse-whitespace --remove-comments --remove-optional-tags --remove-redundant-attributes --remove-script-type-attributes --use-short-doctype --minify-css true --minify-js true",
    "minify": "npm run minify:css && npm run minify:js",
    "build": "npm run build:sw && npm run minify",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:sw": "node update-sw-cache.cjs",
    "build:seo": "node scripts/build-seo.mjs",
    "build:sitemap": "node scripts/sitemap.mjs",
    "build:pages": "npm run build:seo && npm run build:sitemap",
    "check:static": "node scripts/check.mjs",
    "check": "node scripts/check.mjs --lighthouse",
    "build:site": "node scripts/build-site.mjs",
    "design:content": "node scripts/design-content.mjs"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.63.0",
    "@html-eslint/parser": "^0.63.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.61.1",
    "csso-cli": "^4.0.2",
    "eslint": "^10.6.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "8.7.4",
    "js-beautify": "^2.0.3",
    "node-html-parser": "^7.1.0",
    "serve": "^14.2.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.49.0",
    "three": "^0.185.1"
  },
  "type": "module"
}
