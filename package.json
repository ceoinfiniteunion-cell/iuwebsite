{
  "name": "iu-site",
  "version": "1.0.0",
  "description": "Infinite Union website",
  "scripts": {
    "lint:html": "html-validate index.html \"en/**/index.html\" \"services/*/index.html\" \"blog/**/index.html\" \"portfolio/index.html\" \"pricing/index.html\" 404.html",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:js": "eslint index.html \"services/*/index.html\" src/js scripts",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lhci": "lhci autorun",
    "start": "npx serve . -p ${PORT:-3000} -c serve.json",
    "build": "node scripts/render-design.mjs && node scripts/sitemap.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:sitemap": "node scripts/sitemap.mjs",
    "check:static": "node scripts/check.mjs",
    "check": "node scripts/check.mjs --lighthouse",
    "build:site": "node scripts/build-site.mjs",
    "design:content": "node scripts/design-content.mjs",
    "build:fast": "node scripts/render-design.mjs --no-capture && node scripts/sitemap.mjs",
    "build:stills": "node scripts/render-3d-stills.mjs",
    "visual": "node scripts/visual-diff.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.63.0",
    "@html-eslint/parser": "^0.63.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.61.1",
    "csso-cli": "^4.0.2",
    "eslint": "^10.6.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "8.7.4",
    "js-beautify": "^2.0.3",
    "node-html-parser": "^7.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.49.0",
    "three": "^0.185.1"
  },
  "type": "module"
}
