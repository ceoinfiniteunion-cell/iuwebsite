{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/services/websites/index.html",
        "http://localhost/pricing/index.html",
        "http://localhost/portfolio/index.html",
        "http://localhost/blog/skilky-koshtuye-sayt-2026/index.html",
        "http://localhost/en/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "skipAudits": [
          "is-crawlable"
        ],
        "blockedUrlPatterns": [
          "*googletagmanager.com*",
          "*google-analytics.com*",
          "*doubleclick.net*",
          "*googleadservices.com*",
          "*google.com/pagead*",
          "*google.com/rmkt*",
          "*google.com/ccm*",
          "*sentry-cdn.com*",
          "*res.cloudinary.com*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ]
      }
    }
  }
}
